# Database — Supabase Postgres (Transaction pooler URI)
DATABASE_URI=postgresql://postgres.bvhhhnlxfpdyaphbgzoe:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Payload secret — generate a random 32+ char string
PAYLOAD_SECRET=replace-with-a-long-random-secret-string

# Public URL of this CMS app
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# LME website URL (for live preview and ISR revalidation webhook)
LME_SITE_URL=http://localhost:3000
LME_REVALIDATE_SECRET=replace-with-shared-secret   # must match REVALIDATION_SECRET in the website project

# SEO — DataForSEO (can also be set in CMS Admin > SEO Settings)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# SEO — Google PageSpeed Insights API (can also be set in CMS Admin > SEO Settings)
GOOGLE_PSI_API_KEY=
