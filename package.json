{
  "name": "lme-cms",
  "version": "1.0.0",
  "description": "Payload CMS for Loch Monster Electric",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "seo:discover": "tsx -e \"fetch('http://localhost:3001/api/seo/discover-competitors',{method:'POST'}).then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2)))\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "graphql": "^16.8.1",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "payload": "^3.84.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
